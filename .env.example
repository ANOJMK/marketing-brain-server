# ============================================================
# BRAIN AFRICA LABS — SERVER
# ============================================================

NODE_ENV=production

PORT=3000

# ============================================================
# PUBLIC URL
# ============================================================

SERVER_PUBLIC_URL=https://oauth.brainafricalabs.com

FRONTEND_URL=https://brainafricalabs.com

# ============================================================
# TIKTOK
# ============================================================

TIKTOK_CLIENT_KEY=YOUR_TIKTOK_CLIENT_KEY

TIKTOK_CLIENT_SECRET=YOUR_TIKTOK_CLIENT_SECRET

TIKTOK_REDIRECT_URI=https://oauth.brainafricalabs.com/tiktok/callback

# Scopes réellement demandés
TIKTOK_SCOPES=user.info.basic,video.publish

# ============================================================
# SECURITY
# ============================================================

# Génère une longue chaîne aléatoire.
# Exemple :
# openssl rand -hex 32

OAUTH_STATE_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# ============================================================
# SUPABASE
# ============================================================

SUPABASE_URL=https://YOUR_PROJECT.supabase.co

SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Table dédiée aux connexions OAuth TikTok
SUPABASE_TIKTOK_TABLE=tiktok_oauth_accounts

# ============================================================
# APPLICATION
# ============================================================

DEFAULT_ACCOUNT_ID=2
